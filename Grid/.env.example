# ===== 币安合约网格策略 配置模板（复制为 .env 后填写） =====
# 优先级：系统环境变量 > .env > 代码内默认值。

# WebSocket / REST 代理，留空表示直连，例如 http://127.0.0.1:7897
PROXY=

# 币安 API 凭证（模拟盘请在币安 Demo Trading 页面申请对应的 Key）
API_KEY=
SECRET=

# 模拟盘开关：true 使用模拟盘地址，false 使用实盘
DEMO=true

# 交易对，例如 BTCUSDT / DOGEUSDT
SYMBOL=DOGEUSDT

# 网格间距万分比 / 10000，例如 1 表示 0.01%，5 表示 0.05%
SPACING=5

# 每格投入的 USDT
USDT=20

# 最小变动单位，币种不同精度不同，例如 BTCUSDT 为 0.01，DOGEUSDT 为 0.00001
MINI_CHANGE=0.00001

# 上方（价格更高、编号更小）格子数
GRID_UP=2

# 下方（价格更低、编号更大）格子数
GRID_DOWN=3
